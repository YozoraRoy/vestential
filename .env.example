# ─── LLM Provider 設定 ───────────────────────────
# 選擇要用哪一家: openai (如 OpenCode, OpenRouter) / google / anthropic
LLM_PROVIDER=openai

# ─── OpenCode Zen (預設) ────────────────────────
# 註冊並取得 API Key：https://opencode.ai
OPENAI_API_KEY=sk-...
LLM_BACKEND_URL=https://opencode.ai/zen/v1

# OpenCode 模型選擇 (例如 big-pickle)：
DEEP_THINK_MODEL=big-pickle
QUICK_THINK_MODEL=big-pickle

# ─── 備用機制 (Fallback) ──────────────
# primary 失敗（429/逾時/配額封鎖）時切到 fallback，可當作免費 API token 備援。
# deep / quick 兩組可各自獨立設定（deep 給 Research/Portfolio Manager，quick 給其餘 6 個 agent）。
FALLBACK_LLM_PROVIDER=openai
# 免費 fallback 務必使用 Groq 上「實際存在且可呼叫」的 model id，
# 並留意免費層單一請求有 token 上限（否則上游會回 413 request_too_large）。
FALLBACK_DEEP_THINK_MODEL=qwen/qwen3.8-27b
FALLBACK_QUICK_THINK_MODEL=qwen/qwen3.8-27b

# 若要真正切到「另一家」免費 API（不同 baseUrl），請各自填 baseUrl + apiKey。
# 群組專屬 (FALLBACK_DEEP_*/FALLBACK_QUICK_*) 優先於通用 (FALLBACK_LLM_*)，通用又優於沿用 primary。
# 例：deep 組切到 Groq、quick 組維持沿用 primary：
# FALLBACK_DEEP_LLM_BACKEND_URL=https://api.groq.com/openai/v1
# FALLBACK_DEEP_LLM_API_KEY=GROQ_KEY_HERE
# FALLBACK_QUICK_LLM_BACKEND_URL=
# FALLBACK_QUICK_LLM_API_KEY=
# 若只改模型不分流，留空即可（fallback 會沿用 LLM_BACKEND_URL / OPENAI_API_KEY）。

# ─── Fallback tier2（FALLBACK2_*，第三層備援）─────────
# primary → FALLBACK_* (tier1) → FALLBACK2_* (tier2)，依序往下一層。
# 任一 FALLBACK2_* 變數存在即啟用；provider 缺省沿用 tier1。
# 例：兩把 Groq key 依序輪換（tier1 用光免費額度 → 切 tier2 key）。
FALLBACK2_LLM_PROVIDER=openai
# FALLBACK2_DEEP_THINK_MODEL=qwen/qwen3.8-27b
# FALLBACK2_QUICK_THINK_MODEL=qwen/qwen3.8-27b
# FALLBACK2_DEEP_LLM_BACKEND_URL=https://api.groq.com/openai/v1
# FALLBACK2_DEEP_LLM_API_KEY=GROQ_KEY2_HERE
# FALLBACK2_QUICK_LLM_BACKEND_URL=https://api.groq.com/openai/v1
# FALLBACK2_QUICK_LLM_API_KEY=GROQ_KEY2_HERE

# ─── Google AI Studio (備用選項) ─────────────────
# FALLBACK_LLM_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
# FALLBACK_DEEP_THINK_MODEL=gemini-2.5-flash
# FALLBACK_QUICK_THINK_MODEL=gemini-2.5-flash

# ─── 其他設定 ────────────────────────────────────
LLM_TEMPERATURE=0.7

# ─── 圖片辨識 (AI 讀取庫存截圖/對帳單) ─────────────
# 最多嘗試次數 (1~5，預設 3)：驗證失敗時會把上次輸出 + 錯誤欄位回饋給 LLM 修正重試
# RECOGNIZE_MAX_ATTEMPTS=3
# OCR 文字送 LLM 的上限字元數（預設 2400）。Groq 等 fallback 的 TPM 極低，文字過多會觸發 413
# RECOGNIZE_OCR_MAX_CHARS=2400
# 辨識輸出的 token 上限（預設 900）。Groq 的 TPM=8000 會把 max_tokens 預算也算進去，
# 預算過大會直接 413/打穿 TPM；輸出具只有小 JSON，900 綽綽有餘
# RECOGNIZE_MAX_TOKENS=900
# OCR 前置處理：放大後長邊上限（預設 2400x3000）與 PSM（預設 6，表格模式）。
# 灰階 + 放大 + normalize + sharpen 對券商 App 庫存小字效果最佳
# RECOGNIZE_OCR_MAX_W=2400
# RECOGNIZE_OCR_MAX_H=3000
# RECOGNIZE_OCR_PSM=6

# ─── 登入 (OAuth) ────────────────────────────────
# 簽發 session cookie 的密鑰 (使用 `openssl rand -base64 32` 產生)
AUTH_SECRET=
# 對外 base URL (Azure 設為 https://vestential.com；本機可不設)
AUTH_BASE_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login (https://developers.line.biz/) — 注意 LINE 不允許 localhost redirect
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# ─── Email 通知 (市場焦點每日總覽 / 異常告警) ─────────────────────
# 寄件帳號需開 2FA 並建立 Gmail「應用程式密碼」(16 字元,可去空格)。
# 私密值只放本機 .env.local 與 Azure App Settings,禁止 commit 進 repo。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vestential@gmail.com
SMTP_PASS=your_gmail_app_password_here
# 顯示的寄件者 Email(預設沿用 SMTP_USER)
NOTIFY_FROM=
# 收件人(每日總覽與異常告警都會寄到這裡);留空 = 不寄送
NOTIFY_TO=
